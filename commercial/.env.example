# Copy to .env. Never put this file in the customer ZIP.
HOST=127.0.0.1
PORT=3610
# Enable only behind a reverse proxy on this same server's loopback interface.
TRUST_PROXY=false
# file runs without a database; mysql uses your existing Alibaba RDS.
ACCOUNT_STORE=file
MYSQL_URL=mysql://pureisp:CHANGE_ME@YOUR_RDS_HOST:3306/pureisp
MYSQL_SSL_CA=
DATA_DIRECTORY=./data
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME
ADMIN_KEY=CHANGE_ME
# Keep this server-only key stable and back it up; it decrypts stored cards.
CARD_ENCRYPTION_KEY=CHANGE_ME
RENEWAL_URL=https://account.example.com/renew
# One tiny revision query per 10s, independent of customer count.
DB_POLL_SECONDS=10
